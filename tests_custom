#!/bin/sh
#################################################################################
#
# tests_custom - Lynis custom tests that run two external audit scripts:
#   CUST-0910  suid-sgid-audit.sh   (SUID/SGID permission audit)
#   CUST-0920  automation-audit.sh  (scheduled tasks, services, privileges)
#
# Install: copy to the Lynis include directory as "tests_custom"
#          (find it with: lynis show includedir), owned by root, mode 640.
# Lynis sources this file with /bin/sh, so it must stay POSIX sh: no arrays,
# no [[ ]], no bash-only syntax.
#
# The scripts are audit-only. Their findings are imported into Lynis:
#   CRITICAL/HIGH -> ReportWarning      MEDIUM -> ReportSuggestion
#   LOW/INFO      -> written to the Lynis log only
#
#################################################################################
#
    CUST_AUDIT_DIR="/usr/local/lib/lynis-custom"     # where the two scripts live
    CUST_AUDIT_OUT="/var/log/lynis-custom"           # where their reports go

    # Only run a helper script that root owns and nobody else can modify,
    # because Lynis (running as root) is about to execute it.
    CustScriptIsSafe() {
        [ -f "$1" ] && [ -x "$1" ] || return 1
        CUST_OWNER=$(stat -c '%u' "$1" 2>/dev/null)
        CUST_PERMS=$(stat -c '%A' "$1" 2>/dev/null)
        [ "${CUST_OWNER}" = "0" ] || return 1
        case "${CUST_PERMS}" in
            ?????w????|????????w?) return 1 ;;    # group- or world-writable
        esac
        return 0
    }

    # Import "SEVERITY|RULE|ITEM|MESSAGE" lines produced with the -M option.
    CustImportFindings() {
        CUST_HIGH=0; CUST_MED=0; CUST_LOW=0
        while IFS='|' read -r CUST_SEV CUST_RULE CUST_ITEM CUST_MSG; do
            [ -n "${CUST_SEV}" ] || continue
            case "${CUST_SEV}" in
                CRITICAL|HIGH)
                    CUST_HIGH=$((CUST_HIGH + 1))
                    ReportWarning "${TEST_NO}" "${CUST_RULE}: ${CUST_MSG}" "${CUST_ITEM}" "text:See $2"
                    ;;
                MEDIUM)
                    CUST_MED=$((CUST_MED + 1))
                    ReportSuggestion "${TEST_NO}" "${CUST_RULE}: ${CUST_MSG}" "${CUST_ITEM}" "text:See $2"
                    ;;
                *)
                    CUST_LOW=$((CUST_LOW + 1))
                    LogText "Result: ${CUST_SEV} ${CUST_RULE} ${CUST_ITEM}: ${CUST_MSG}"
                    ;;
            esac
        done <<EOF
$1
EOF
    }

    CustShowResult() {   # label
        if [ "${CUST_HIGH}" -gt 0 ]; then
            Display --indent 2 --text "- $1" --result "${STATUS_WARNING}" --color RED
            AddHP 0 2
        elif [ "${CUST_MED}" -gt 0 ]; then
            Display --indent 2 --text "- $1" --result "${STATUS_SUGGESTION}" --color YELLOW
            AddHP 1 2
        else
            Display --indent 2 --text "- $1" --result "${STATUS_OK}" --color GREEN
            AddHP 2 2
        fi
        Display --indent 4 --text "High/critical: ${CUST_HIGH}, medium: ${CUST_MED}, low/info: ${CUST_LOW}"
    }
#
#################################################################################
#
    # Test        : CUST-0910
    # Description : SUID/SGID permission audit (external script)
    CUST_SCRIPT="${CUST_AUDIT_DIR}/suid-sgid-audit.sh"
    SKIPREASON=""
    if CustScriptIsSafe "${CUST_SCRIPT}"; then PREQS_MET="YES"; else PREQS_MET="NO"; SKIPREASON="${CUST_SCRIPT} missing, not executable, or not root-owned/protected"; fi
    Register --test-no CUST-0910 --preqs-met "${PREQS_MET}" --skip-reason "${SKIPREASON}" --root-only YES --weight H --network NO --category security --description "Audit SUID/SGID files (custom script)"
    if [ "${SKIPTEST}" -eq 0 ]; then
        mkdir -p "${CUST_AUDIT_OUT}" && chmod 700 "${CUST_AUDIT_OUT}"
        CUST_REPORT="${CUST_AUDIT_OUT}/suid-sgid-report.txt"
        LogText "Test: running ${CUST_SCRIPT} (report: ${CUST_REPORT})"
        CUST_RESULTS=$("${CUST_SCRIPT}" -M -o "${CUST_REPORT}" 2>>"${LOGFILE}")
        CUST_RC=$?
        LogText "Result: script finished with exit code ${CUST_RC}"
        if [ "${CUST_RC}" -ge 2 ]; then
            Display --indent 2 --text "- SUID/SGID audit (custom script)" --result "${STATUS_ERROR}" --color RED
            ReportException "${TEST_NO}" "suid-sgid-audit.sh failed with exit code ${CUST_RC}"
        else
            CustImportFindings "${CUST_RESULTS}" "${CUST_REPORT}"
            CustShowResult "SUID/SGID audit (custom script)"
            Report "cust_suid_sgid_report=${CUST_REPORT}"
        fi
    fi
#
#################################################################################
#
    # Test        : CUST-0920
    # Description : Scheduled task, service and privilege audit (external script)
    CUST_SCRIPT="${CUST_AUDIT_DIR}/automation-audit.sh"
    SKIPREASON=""
    if CustScriptIsSafe "${CUST_SCRIPT}"; then PREQS_MET="YES"; else PREQS_MET="NO"; SKIPREASON="${CUST_SCRIPT} missing, not executable, or not root-owned/protected"; fi
    Register --test-no CUST-0920 --preqs-met "${PREQS_MET}" --skip-reason "${SKIPREASON}" --root-only YES --weight M --network NO --category security --description "Audit scheduled tasks and privileged services (custom script)"
    if [ "${SKIPTEST}" -eq 0 ]; then
        mkdir -p "${CUST_AUDIT_OUT}" && chmod 700 "${CUST_AUDIT_OUT}"
        CUST_REPORT="${CUST_AUDIT_OUT}/automation-report.txt"
        LogText "Test: running ${CUST_SCRIPT} (report: ${CUST_REPORT})"
        CUST_RESULTS=$("${CUST_SCRIPT}" -M -o "${CUST_REPORT}" 2>>"${LOGFILE}")
        CUST_RC=$?
        LogText "Result: script finished with exit code ${CUST_RC}"
        if [ "${CUST_RC}" -ge 2 ]; then
            Display --indent 2 --text "- Automation audit (custom script)" --result "${STATUS_ERROR}" --color RED
            ReportException "${TEST_NO}" "automation-audit.sh failed with exit code ${CUST_RC}"
        else
            CustImportFindings "${CUST_RESULTS}" "${CUST_REPORT}"
            CustShowResult "Automation audit (custom script)"
            Report "cust_automation_report=${CUST_REPORT}"
        fi
    fi
#
#################################################################################
#
# EOF
